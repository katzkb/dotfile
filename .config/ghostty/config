font-family = HackGen35 Console NF
font-size = 14.0

#font-family = x14y24pxHeadUpDaisy
#font-size = 16.0

font-style = Regular
font-thicken

background-opacity = 0.70
background-blur-radius = 20

theme = Catppuccin Macchiato

shell-integration = zsh
shell-integration-features = no-cursor

cursor-style = block_hollow
cursor-style-blink = false

# window-padding-x = 20
# window-padding-y = 5
# window-padding-balance = true
window-theme = ghostty

#fullscreen
#macos-non-native-fullscreen = true
macos-titlebar-style = transparent

title = "👻"
macos-titlebar-proxy-icon = hidden

# macos-icon = glass
macos-icon = custom-style
macos-icon-frame = "beige"
macos-icon-ghost-color = FF0033
macos-icon-screen-color = 06C756

# Cursor shaders
# Existing pack (active)
custom-shader = ./shader/cursor_warp.glsl
# custom-shader = ./shader/ripple_cursor.glsl
# Self-built — uncomment one to switch (mood-based)
custom-shader = ./shaders/glow-mauve.glsl
# custom-shader = ./shaders/glow-teal.glsl
custom-shader = ./shaders/ripple-mauve.glsl
# custom-shader = ./shaders/ripple-teal.glsl
# Murasaki (虚式・茈) — comment out the chain above & uncomment one to try
# custom-shader = ./shaders/murasaki-vortex.glsl
# custom-shader = ./shaders/murasaki-orbital.glsl
# custom-shader = ./shaders/murasaki-distortion.glsl
custom-shader-animation = always
